    "word=\"mom\"\n",
    "rev=\"\"\n",
    "for i in word:\n",
    "    rev=i+rev\n",
    "print(rev)\n",
    "if word==rev:\n",
    "    print(\"palindrome\")\n",
    "else:\n",
    "    print(\"not a palindrome\")"
   ]
